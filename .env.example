ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=chungbuk_emergency
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chungbuk_emergency
PUBLIC_DATA_API_KEY=
HIRA_API_KEY=
NEMC_API_KEY=
MOLIT_TRAFFIC_API_KEY=
MOLIT_TRAFFIC_BASE_URL=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=20
HIRA_BASE_URL=https://apis.data.go.kr/B551182/hospInfoServicev2
HIRA_DETAIL_BASE_URL=https://apis.data.go.kr/B551182/MadmDtlInfoService2.8
NEMC_BASE_URL=https://apis.data.go.kr/B552657/ErmctInfoInqireService
# Keep empty until the provider timezone is confirmed; e.g. Asia/Seoul only with evidence.
NEMC_SOURCE_TIMEZONE=
NAVER_DIRECTIONS_BASE_URL=https://maps.apigw.ntruss.com/map-direction/v1
NAVER_GEOCODING_BASE_URL=https://maps.apigw.ntruss.com/map-geocode/v2
AIHUB_DATA_ROOT=
AIHUB_API_KEY=
ITS_NODE_LINK_DATA_ROOT=
BACKEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_NAVER_MAP_CLIENT_ID=
ROUTE_DATA_MAX_AGE_SECONDS=
HOSPITAL_DATA_MAX_AGE_SECONDS=
HOSPITAL_STATUS_MAX_AGE_SECONDS=
EMERGENCY_INSTITUTION_DATA_MAX_AGE_SECONDS=
CHUNGBUK_SIDO_CODE=330000
CHUNGBUK_REGION_NAME=충청북도
NEMC_HIRA_COORDINATE_WARNING_METERS=1000
CANDIDATE_RADIUS_KM=10
# Empty means no application-side cap. The provider quota and 429 responses still apply.
NAVER_DIRECTIONS_MAX_CALLS=
RECOMMENDATION_ROUTE_CANDIDATE_LIMIT=10
ROUTING_MAX_CONCURRENCY=3

# Speech AI는 승인된 provider가 정해지기 전까지 비워 둡니다.
SPEECH_STT_PROVIDER=
SPEECH_ENTITY_EXTRACTOR=
SPEECH_AUDIO_ROOT=
SPEECH_MAX_AUDIO_BYTES=26214400
SPEECH_ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.flac
BACKEND_TIMEOUT_SECONDS=10
BACKEND_MAX_RETRIES=2

# 비워 두면 자동 수집 worker가 시작되지 않습니다. 제공기관 정책 확인 후 초 단위로 설정합니다.
NEMC_SYNC_INTERVAL_SECONDS=
