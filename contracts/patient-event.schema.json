{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/patient-event.schema.json",
  "title": "Patient Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "observed_at", "location", "symptoms", "consciousness_status", "breathing_status", "bleeding_status", "urgency_level", "source"],
  "properties": {
    "incident_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "address_text"],
      "oneOf": [
        {
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        {
          "properties": {
            "latitude": { "type": "null" },
            "longitude": { "type": "null" }
          }
        }
      ],
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "address_text": { "type": ["string", "null"] }
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label", "confidence"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "consciousness_status": { "type": ["string", "null"] },
    "breathing_status": { "type": ["string", "null"] },
    "bleeding_status": { "type": ["string", "null"] },
    "urgency_level": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_name", "model_version"],
      "properties": {
        "model_name": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
