{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/hospital-candidate.schema.json",
  "title": "Hospital Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["hospital_id", "hospital_name", "location", "source", "freshness", "emergency_profile"],
  "properties": {
    "hospital_id": { "type": "string", "minLength": 1 },
    "hospital_name": { "type": "string", "minLength": 1 },
    "hospital_type_code": { "type": ["string", "null"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "address"],
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "address": { "type": ["string", "null"] }
      }
    },
    "departments": { "type": "array", "items": { "type": "object" } },
    "equipment": { "type": "array", "items": { "type": "object" } },
    "capabilities": { "type": "array", "items": { "type": "object" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "source_record_id", "fetched_at", "schema_version", "raw_payload_id"],
      "properties": {
        "source_name": { "type": "string" },
        "source_record_id": { "type": ["string", "null"] },
        "fetched_at": { "type": "string", "format": "date-time" },
        "source_updated_at": { "type": ["string", "null"] },
        "schema_version": { "type": "string" },
        "raw_payload_id": { "type": ["string", "null"] }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at"],
      "properties": {
        "status": { "type": "string", "enum": ["fresh", "stale", "unknown", "unavailable"] },
        "observed_at": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "emergency_profile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "emergency_type_code",
        "emergency_type_name",
        "representative_phone",
        "emergency_phone",
        "source_name",
        "source_record_id",
        "raw_payload_id",
        "schema_version",
        "fetched_at",
        "source_updated_at",
        "match_method",
        "coordinate_warning",
        "freshness"
      ],
      "properties": {
        "emergency_type_code": { "type": ["string", "null"] },
        "emergency_type_name": { "type": ["string", "null"] },
        "representative_phone": { "type": ["string", "null"] },
        "emergency_phone": { "type": ["string", "null"] },
        "source_name": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "raw_payload_id": { "type": ["string", "null"] },
        "schema_version": { "type": "string", "minLength": 1 },
        "fetched_at": { "type": "string", "format": "date-time" },
        "source_updated_at": { "type": ["string", "null"], "format": "date-time" },
        "match_method": { "type": "string", "minLength": 1 },
        "coordinate_warning": { "type": "boolean" },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_at", "reason"],
          "properties": {
            "status": { "type": "string", "enum": ["fresh", "stale", "unknown", "unavailable"] },
            "observed_at": { "type": ["string", "null"], "format": "date-time" },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
